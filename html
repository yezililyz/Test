<style>
  :root{
    --bg:#f7f6f2; --ink:#171717; --muted:#6f6d68; --line:#ddd9d1;
    --card:#fffdf8; --accent:#d9ff4f; --accent2:#c7b7ff; --dark:#191919;
    --shadow:0 18px 60px rgba(20,20,20,.10); --radius:28px;
  }
  *{box-sizing:border-box}
  html{scroll-behavior:smooth}
  body{margin:0;background:var(--bg);color:var(--ink);font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;line-height:1.45}
  a{color:inherit;text-decoration:none}
  button{font:inherit}
  .wrap{width:min(1180px,calc(100% - 40px));margin:auto}
  nav{position:sticky;top:0;z-index:20;background:rgba(247,246,242,.86);backdrop-filter:blur(16px);border-bottom:1px solid rgba(221,217,209,.7)}
  .navin{height:72px;display:flex;align-items:center;justify-content:space-between}
  .brand{font-weight:800;letter-spacing:-.04em;font-size:20px}
  .navlinks{display:flex;gap:26px;font-size:14px;color:#444}
  .navlinks a:hover{color:#000}
  .contact{background:var(--ink);color:#fff;padding:11px 17px;border-radius:999px;font-weight:700;font-size:13px}
  .hero{padding:92px 0 70px;display:grid;grid-template-columns:1.25fr .75fr;gap:50px;align-items:end}
  .eyebrow{display:inline-flex;align-items:center;gap:8px;font-size:13px;font-weight:800;text-transform:uppercase;letter-spacing:.12em;color:#585650}
  .dot{width:8px;height:8px;border-radius:50%;background:#6ee66e;box-shadow:0 0 0 5px rgba(110,230,110,.16)}
  h1{font-size:clamp(58px,9vw,122px);line-height:.84;letter-spacing:-.085em;margin:22px 0 28px;max-width:850px}
  .hero p{font-size:20px;max-width:680px;color:#494742;margin:0}
  .hero-actions{display:flex;gap:12px;margin-top:30px;flex-wrap:wrap}
  .btn{border:1px solid var(--ink);border-radius:999px;padding:13px 20px;font-weight:750;cursor:pointer;transition:.2s}
  .btn.primary{background:var(--ink);color:white}.btn.secondary{background:transparent}
  .btn:hover{transform:translateY(-2px)}
  .hero-card{background:var(--dark);color:white;border-radius:var(--radius);padding:30px;min-height:300px;display:flex;flex-direction:column;justify-content:space-between;box-shadow:var(--shadow);position:relative;overflow:hidden}
  .hero-card:after{content:"";position:absolute;width:190px;height:190px;background:var(--accent);border-radius:50%;right:-55px;top:-55px;filter:blur(1px)}
  .hero-card .big{font-size:65px;line-height:.9;letter-spacing:-.08em;position:relative;z-index:1}
  .hero-card .small{color:#c7c5bf;font-size:14px;max-width:240px;position:relative;z-index:1}
  .marquee{border-top:1px solid var(--line);border-bottom:1px solid var(--line);overflow:hidden;white-space:nowrap;padding:15px 0;color:#555}
  .marquee span{display:inline-block;animation:slide 24s linear infinite}
  .marquee b{color:#111;margin:0 25px}
  @keyframes slide{from{transform:translateX(0)}to{transform:translateX(-35%)}}
  section{padding:105px 0}
  .section-head{display:flex;justify-content:space-between;gap:30px;align-items:end;margin-bottom:38px}
  .section-head h2{font-size:clamp(38px,5vw,68px);letter-spacing:-.065em;line-height:.95;margin:0}
  .section-head p{max-width:430px;color:var(--muted);margin:0}
  .workgrid{display:grid;grid-template-columns:repeat(2,1fr);gap:18px}
  .project{border-radius:var(--radius);min-height:420px;padding:28px;display:flex;flex-direction:column;justify-content:space-between;position:relative;overflow:hidden;cursor:pointer;transition:.25s;box-shadow:0 2px 0 rgba(0,0,0,.03)}
  .project:hover{transform:translateY(-5px);box-shadow:var(--shadow)}
  .p1{background:#dff6c5}.p2{background:#ddd3ff}.p3{background:#ffd6b8}.p4{background:#ccecf0}
  .project .meta{display:flex;justify-content:space-between;font-size:12px;font-weight:800;text-transform:uppercase;letter-spacing:.08em}
  .project h3{font-size:42px;letter-spacing:-.06em;line-height:.95;margin:0 0 12px;max-width:520px}
  .project p{max-width:490px;margin:0;color:#3f3e3a}
  .case{margin-top:24px;display:inline-flex;width:max-content;border:1px solid rgba(0,0,0,.28);border-radius:999px;padding:9px 13px;font-size:12px;font-weight:800}
  .metrics{display:grid;grid-template-columns:repeat(4,1fr);border:1px solid var(--line);border-radius:var(--radius);overflow:hidden;background:var(--card)}
  .metric{padding:30px;border-right:1px solid var(--line)}.metric:last-child{border-right:0}
  .metric strong{display:block;font-size:43px;letter-spacing:-.07em}.metric span{color:var(--muted);font-size:13px}
  .about{display:grid;grid-template-columns:.8fr 1.2fr;gap:80px}
  .about h2{font-size:56px;letter-spacing:-.07em;line-height:.92;margin:0}
  .about-copy{font-size:21px;color:#41403c}
  .about-copy p{margin-top:0}
  .chips{display:flex;gap:8px;flex-wrap:wrap;margin-top:25px}
  .chip{border:1px solid var(--line);padding:9px 12px;border-radius:999px;background:var(--card);font-size:13px}
  .timeline{border-top:1px solid var(--line)}
  .role{display:grid;grid-template-columns:140px 1fr auto;gap:30px;padding:25px 0;border-bottom:1px solid var(--line);align-items:start}
  .role .date{font-size:13px;color:var(--muted)} .role h3{margin:0;font-size:22px;letter-spacing:-.035em}.role p{margin:5px 0 0;color:var(--muted);font-size:14px}
  .tag{font-size:11px;border:1px solid var(--line);border-radius:999px;padding:7px 9px;white-space:nowrap}
  .principles{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}
  .principle{background:var(--card);border:1px solid var(--line);border-radius:var(--radius);padding:28px;min-height:230px}
  .principle .num{font-size:13px;color:var(--muted)} .principle h3{font-size:28px;letter-spacing:-.05em;margin:55px 0 8px}.principle p{color:var(--muted);margin:0}
  .cta{background:var(--ink);color:white;border-radius:34px;padding:60px;display:flex;justify-content:space-between;gap:40px;align-items:end}
  .cta h2{font-size:clamp(48px,7vw,88px);line-height:.88;letter-spacing:-.075em;margin:0;max-width:720px}
  .cta p{color:#bdbbb5;max-width:330px}
  .cta a{background:var(--accent);color:#111;border-radius:999px;padding:14px 19px;font-weight:800;display:inline-block}
  footer{padding:35px 0 50px;display:flex;justify-content:space-between;color:var(--muted);font-size:13px}
  .modal{position:fixed;inset:0;background:rgba(0,0,0,.45);z-index:50;display:none;align-items:center;justify-content:center;padding:20px}
  .modal.open{display:flex}.modalbox{background:var(--card);max-width:760px;width:100%;max-height:88vh;overflow:auto;border-radius:30px;padding:34px;box-shadow:var(--shadow)}
  .modalbox h2{font-size:46px;line-height:.95;letter-spacing:-.06em;margin:10px 0 20px}.close{float:right;border:0;background:#eee;border-radius:50%;width:36px;height:36px;cursor:pointer;font-size:20px}
  .modalbox .result{font-size:18px;color:#4a4944}.modalbox ul{padding-left:20px}.modalbox li{margin:9px 0}
  @media(max-width:800px){
    .navlinks{display:none}.hero{grid-template-columns:1fr;padding-top:65px}.hero-card{min-height:230px}
    .workgrid,.about,.principles{grid-template-columns:1fr}.metrics{grid-template-columns:1fr 1fr}.metric:nth-child(2){border-right:0}.metric:nth-child(-n+2){border-bottom:1px solid var(--line)}
    .role{grid-template-columns:1fr auto}.role .date{grid-column:1/-1}.cta{padding:38px 28px;display:block}.cta a{margin-top:20px}
    section{padding:75px 0}
  }
</style>
